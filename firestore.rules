rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is host
    function isHost() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'host';
    }

    // User profiles and logs
    match /users/{userId} {
      // Allow user to read/write their own doc
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Allow host to read/write/delete any doc
      allow read, write, delete: if request.auth != null && isHost();
      
      match /logs/{logId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isHost());
      }
    }

    // App Configuration (Roadmaps, etc.)
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isHost();
    }

    // Course Content (Weeks, Projects, Resources, Skills)
    match /weeks/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isHost();
    }
    match /projects/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isHost();
    }
    match /resources/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isHost();
    }
    match /skills/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isHost();
    }
  }
}
